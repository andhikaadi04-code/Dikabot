# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SNOWKIT_ENDPOINT: SnowKit API endpoint (default: https://snow.kairogg.com.br)
SNOWKIT_ENDPOINT="https://snow.kairogg.com.br"

# SNOWKIT_TOKEN: Valid SnowKit API token
SNOWKIT_TOKEN="MY_SNOWKIT_TOKEN"

# WHATSAPP_BOT_JID: Identitas JID bot untuk metadata pesan Rich Response (default: 867051314767696@bot atau nomor_bot@s.whatsapp.net)
WHATSAPP_BOT_JID="867051314767696@bot"

# BOT_NUMBER: Nomor WhatsApp Bot untuk login via Pairing Code (Contoh: 6281234567890)
# Jika diisi, server akan otomatis meminta 8-digit Pairing Code di konsol panel!
BOT_NUMBER="6281234567890"
ENABLE_WHATSAPP_BOT="true"
